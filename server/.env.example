NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/fire_safety_platform
# Or MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/fire_safety_platform

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# Client apps (for CORS + links in emails)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Cloudinary (leave blank in dev — upload endpoints return a clear "not configured" error, they do not silently fail)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Nodemailer) — dev default logs to console; set EMAIL_MODE=smtp with real creds for real sending
EMAIL_MODE=development
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="AK Fire Safety <no-reply@akfiresafety.example>"

# Payments — mock mode works with zero credentials; switch to razorpay once you have keys
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMS / WhatsApp — mock mode logs to console + DB; provider interface ready for MSG91/Twilio
SMS_MODE=mock
SMS_API_KEY=
WHATSAPP_MODE=mock
WHATSAPP_API_KEY=

# Cron schedules (standard cron syntax)
REFILL_REMINDER_CRON=0 9 * * *
AMC_REMINDER_CRON=0 9 * * *
ABANDONED_CART_CRON=0 11 * * *
LOW_STOCK_CRON=0 8 * * *

# Seed
SEED_ADMIN_EMAIL=admin@akfiresafety.example
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Platform Admin
